<%- include('./partials/header') %>

<div class="w-full min-h-[90vh] bg-[#FEFEFE] text-gray-900 pt-28 px-6 sm:px-10 lg:px-20 pb-20 font-sans overflow-hidden">
  
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-12">
    
    <!-- 🛒 LEFT: CART ITEMS -->
    <div class="w-full lg:w-[60%] flex flex-col gap-6">
      <h1 class="text-4xl font-bold font-sans text-gray-900 mb-4 gs-cart-item">Shopping Bag</h1>
      
      <% if (user.cart.length === 0) { %>
        <div class="bg-pastel-beige rounded-3xl p-16 text-center border border-gray-100 shadow-sm gs-cart-item">
          <div class="w-24 h-24 rounded-full bg-white mx-auto flex items-center justify-center mb-6 shadow-sm">
            <i class="ri-shopping-bag-3-line text-4xl text-gray-400"></i>
          </div>
          <h2 class="text-2xl font-bold text-gray-800 mb-3">Your bag is empty</h2>
          <p class="text-gray-500 mb-8 max-w-sm mx-auto">Looks like you haven't added anything yet. Discover our latest curated pieces.</p>
          <a href="/shop" class="inline-block px-8 py-3.5 rounded-full bg-gray-900 text-white font-medium hover:bg-black transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5">
            Explore Collection
          </a>
        </div>
      <% } else { %>
        
        <% user.cart.forEach(function(item) { %>
          <div class="bg-white rounded-3xl p-5 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-50 flex flex-col sm:flex-row gap-6 items-center relative overflow-hidden group gs-cart-item hover:shadow-[0_8px_30px_rgb(0,0,0,0.08)] transition-shadow duration-300">
            
            <!-- IMAGE AREA -->
            <div class="w-full sm:w-40 h-40 flex-shrink-0 rounded-2xl overflow-hidden bg-[#<%= item.product && item.product.bgcolor ? item.product.bgcolor : 'FDFCF0' %>] flex items-center justify-center p-4 relative">
              <% if (item.product && item.product.image) { %>
                <img
                  src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>"
                  class="w-full h-full object-contain max-h-[85%] drop-shadow-xl group-hover:scale-110 transition-transform duration-700 ease-out"
                />
              <% } else { %>
                <i class="ri-image-line text-4xl text-gray-300"></i>
              <% } %>
            </div>

            <!-- PRODUCT DETAILS -->
            <div class="flex-grow flex flex-col justify-between w-full h-full py-2">
              <div class="flex justify-between items-start mb-4">
                <div>
                  <h3 class="text-xl font-bold text-gray-900 tracking-tight">
                    <%= item.product ? item.product.name : "Unknown Product" %>
                  </h3>
                  <p class="text-sm text-gray-500 mt-1 uppercase tracking-wider text-[11px] font-semibold">Premium Edition</p>
                </div>
                <h2 class="font-bold text-xl text-gray-900 bg-gray-50 px-3 py-1 rounded-lg">
                  ₹<%= item.product ? item.product.price * item.quantity : 0 %>
                </h2>
              </div>

              <!-- CONTROLS & ACTIONS -->
              <div class="flex items-center justify-between mt-auto">
                
                <!-- QUANTITY -->
                <div class="flex items-center bg-gray-50 rounded-full border border-gray-200 shadow-sm overflow-hidden">
                  <form action="/users/cart/remove/<%= item._id %>" method="POST" class="m-0 flex">
                    <button type="submit" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:text-black hover:bg-gray-200 transition-colors">
                      <i class="ri-subtract-line font-bold"></i>
                    </button>
                  </form>
                  <span class="w-8 text-center font-bold text-gray-900 text-sm select-none">
                    <%= item.quantity %>
                  </span>
                  <form action="/users/cart/update/<%= item._id %>" method="POST" class="m-0 flex">
                    <button type="submit" class="w-10 h-10 flex items-center justify-center text-gray-500 hover:text-black hover:bg-gray-200 transition-colors">
                      <i class="ri-add-line font-bold"></i>
                    </button>
                  </form>
                </div>
                
                <!-- REMOVE (Uses the same minus route down to zero logic, or just styling as a text link) -->
                <form action="/users/cart/remove/<%= item._id %>" method="POST" class="m-0">
                  <button type="submit" class="text-gray-400 hover:text-red-500 text-sm font-semibold transition-colors flex items-center gap-1 group/remove tracking-wide">
                    <i class="ri-delete-bin-line group-hover/remove:-translate-y-[1px] transition-transform"></i> Remove
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>

      <% } %>

    </div>

    <!-- 💳 RIGHT: PRICE SUMMARY -->
    <div class="w-full lg:w-[40%]">
      <div class="bg-white p-8 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-50 sticky top-32 gs-cart-summary">
        
        <h2 class="text-2xl font-bold mb-8 text-gray-900 tracking-tight">Summary</h2>

        <div class="space-y-4 text-gray-500 font-medium text-sm">
          <div class="flex justify-between items-center">
            <span>Subtotal</span>
            <span class="text-gray-900 font-bold">₹<%= user.cart.reduce((total, item) => total + (item.product ? item.product.price * item.quantity : 0), 0) %></span>
          </div>

          <div class="flex justify-between items-center text-emerald-500">
            <span>Discount</span>
            <span>- ₹<%=user.cart.reduce((total, item) => total + (item.product ? (item.product.discount || 0) * item.quantity : 0), 0) %></span>
          </div>

          <div class="flex justify-between items-center">
            <span>Platform Fee</span>
            <span class="text-gray-900 font-bold">₹<%=user.cart.reduce((total, item) => total + (item.product ? (item.product.platformFee || 0) * item.quantity : 0), 0) %></span>
          </div>

          <div class="flex justify-between items-center">
            <span>Estimated Delivery</span>
            <span class="text-gray-900 font-bold bg-pastel-blue/30 px-2 py-0.5 rounded text-xs uppercase tracking-widest">FREE</span>
          </div>
        </div>

        <div class="my-6 border-b border-gray-100 w-full relative">
            <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-white px-3 text-gray-300 text-xs"><i class="ri-scissors-cut-line"></i></span>
        </div>

        <div class="flex justify-between items-end mb-8">
            <div>
                <p class="text-xs text-gray-400 mb-1 uppercase tracking-widest font-semibold">Total Balance</p>
                <div class="text-4xl font-black text-gray-900 tracking-tight">
                    ₹<%= user.cart.reduce((total, item) => total + (item.product ? (item.product.price - (item.product.discount || 0) + (item.product.platformFee || 0)) * item.quantity : 0), 0) %>
                </div>
            </div>
        </div>

        <ul class="text-xs text-gray-400 mb-8 space-y-2 font-medium">
            <li class="flex items-center"><i class="ri-shield-check-fill text-emerald-400 mr-2 text-sm"></i> Secure and encrypted checkout</li>
            <li class="flex items-center"><i class="ri-arrow-go-back-fill text-emerald-400 mr-2 text-sm"></i> 14-days easy returns policy</li>
        </ul>

        <% if (user.cart.length > 0) { %>
          <!-- To hook up checkout later, this can be wrapped in a form. For now it triggers standard flow. -->
          <button class="w-full relative overflow-hidden group bg-gray-900 text-white font-bold py-4 rounded-xl transition-all hover:bg-black hover:shadow-xl">
            <span class="relative z-10 flex items-center justify-center">
                Secure Checkout <i class="ri-arrow-right-line ml-2 group-hover:translate-x-1 transition-transform"></i>
            </span>
          </button>
        <% } else { %>
          <button disabled class="w-full bg-gray-100 text-gray-400 font-bold py-4 rounded-xl cursor-not-allowed">
            Checkout Unavailable
          </button>
        <% } %>

      </div>
    </div>

  </div>

</div>

<!-- GSAP Animations specifically for Cart -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    if (window.gsap) {
      gsap.from(".gs-cart-item", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: "power3.out"
      });

      gsap.from(".gs-cart-summary", {
        x: 20,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        delay: 0.2
      });
    }
  });
</script>

<%- include('./partials/footer') %>