<%- include('./partials/header') %>

<div class="w-full min-h-[90vh] bg-pastel-white text-gray-900 pt-28 px-10 pb-20 font-sans">
    <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-12">
        
        <!-- Profile Sidebar -->
        <div class="w-full lg:w-1/3 bg-pastel-beige rounded-3xl p-8 shadow-sm border border-gray-100 flex flex-col items-center text-center gs-fade-in">
            <div class="w-32 h-32 rounded-full overflow-hidden bg-white mb-6 border-4 border-pastel-lavender shadow-md relative group">
                <% if(user.picture) { %>
                    <img src="data:image/jpeg;base64,<%= user.picture.toString('base64') %>" alt="Profile Picture" class="w-full h-full object-cover">
                <% } else { %>
                    <div class="w-full h-full flex items-center justify-center bg-gray-50 text-gray-400">
                        <i class="ri-user-fill text-5xl"></i>
                    </div>
                <% } %>
            </div>
            
            <h2 class="text-2xl font-bold font-sans mb-1 text-gray-800"><%= user.fullname %></h2>
            <p class="text-gray-500 text-sm mb-6 font-medium"><%= user.email %></p>
            
            <div class="w-full mt-4 bg-white rounded-2xl p-5 shadow-sm text-left">
                <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4 border-b pb-2">Activity Overview</h3>
                <div class="flex justify-between items-center mb-3">
                    <span class="text-gray-600"><i class="ri-shopping-cart-2-line mr-2 text-pastel-blue"></i>Items in Cart</span>
                    <span class="font-bold"><%= user.cart.length %></span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-gray-600"><i class="ri-file-list-3-line mr-2 text-pastel-lavender"></i>Total Orders</span>
                    <span class="font-bold"><%= user.orders.length %></span>
                </div>
            </div>
            
            <button class="mt-8 w-full py-3 rounded-full bg-gray-900 text-white font-medium hover:bg-gray-800 transition-all shadow-md hover:shadow-lg">
                Edit Profile
            </button>
        </div>
        
        <!-- Orders Section -->
        <div class="w-full lg:w-2/3">
            <h1 class="text-3xl font-bold font-sans mb-8 text-gray-800 gs-slide-up">Your Orders</h1>
            
            <% if (user.orders.length === 0) { %>
                <div class="bg-pastel-blue/30 rounded-3xl p-12 text-center border border-pastel-blue gs-slide-up" style="animation-delay: 0.1s">
                    <div class="w-24 h-24 rounded-full bg-white mx-auto flex items-center justify-center mb-6 shadow-sm">
                        <i class="ri-box-3-line text-4xl text-gray-400"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-700 mb-2">No orders yet</h3>
                    <p class="text-gray-500 mb-8 max-w-md mx-auto">Looks like you haven't made your first purchase. Explore our collection and find something beautiful.</p>
                    <a href="/shop" class="inline-block px-8 py-3 rounded-full bg-black text-white font-medium hover:bg-gray-800 transition-all shadow-md hover:shadow-lg">
                        Start Shopping
                    </a>
                </div>
            <% } else { %>
                <div class="space-y-6">
                    <% user.orders.forEach((order, index) => { %>
                        <div class="bg-white rounded-3xl p-6 shadow-sm border border-gray-100 flex flex-col sm:flex-row gap-6 items-center gs-slide-up" style="animation-delay: <%= index * 0.1 %>s">
                            <!-- Order Info would go here if order detail was structured -->
                            <div class="w-24 h-24 rounded-2xl bg-[#<%= order.product && order.product.bgcolor ? order.product.bgcolor : 'f9fafb' %>] flex-shrink-0 flex items-center justify-center overflow-hidden p-2">
                                <% if(order.product && order.product.image) { %>
                                    <img src="data:image/jpeg;base64,<%= order.product.image.toString('base64') %>" class="w-full h-full object-contain max-h-[90%] drop-shadow-md">
                                <% } else { %>
                                    <i class="ri-image-line text-3xl text-gray-300"></i>
                                <% } %>
                            </div>
                            
                            <div class="flex-grow text-center sm:text-left">
                                <h3 class="text-lg font-bold text-gray-800 mb-1">
                                    <%= order.product ? order.product.name : "Unknown Product" %>
                                </h3>
                                <p class="text-sm text-gray-500 mb-3">Order ID: #ORD-<%= Math.floor(Math.random()*10000) %>-<%= index %></p>
                                <span class="px-3 py-1 bg-green-50 text-green-600 rounded-full text-xs font-semibold uppercase tracking-wider">Completed</span>
                            </div>
                            
                            <div class="text-right w-full sm:w-auto mt-4 sm:mt-0 flex justify-between sm:block">
                                <div class="text-gray-500 sm:mb-1">Amount</div>
                                <div class="font-bold text-lg">₹ <%= order.product ? order.product.price : 0 %></div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
        
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        if(window.gsap) {
            gsap.from(".gs-fade-in", {
                opacity: 0,
                y: 20,
                duration: 0.8,
                ease: "power2.out",
                stagger: 0.1
            });
            
            gsap.from(".gs-slide-up", {
                opacity: 0,
                y: 30,
                duration: 0.8,
                ease: "power2.out",
                stagger: 0.1,
                delay: 0.2
            });
        }
    });
</script>

<%- include('./partials/footer') %>
