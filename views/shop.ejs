<%- include('./partials/header') %>

<% if (success && success.length > 0) { %>
<div class="fixed top-24 left-1/2 transform -translate-x-1/2 z-[1001] bg-emerald-50 border border-emerald-100 text-emerald-600 px-6 py-3 rounded-full shadow-lg flex items-center gap-3 font-medium text-sm flash-msg">
  <i class="ri-checkbox-circle-fill text-lg"></i>
  <span><%= success[0] %></span>
</div>
<% } %>

<main class="w-full min-h-screen bg-pastel-white text-gray-900 font-sans overflow-hidden">
  
  <!-- HERO SECTION -->
  <section class="hero-section relative w-full h-[90vh] flex items-center px-8 md:px-20 pt-20">
    <!-- 3D Canvas Container -->
    <div id="three-canvas" class="absolute top-0 right-0 w-full md:w-1/2 h-full z-0 opacity-80 mix-blend-multiply pointer-events-none"></div>
    
    <div class="relative z-10 w-full md:w-1/2 flex flex-col gap-6 hero-content">
      <div class="inline-block px-4 py-1.5 rounded-full bg-pastel-lavender text-purple-700 text-xs font-bold tracking-widest uppercase w-fit mb-2 hero-pill">
        New Collection 2026
      </div>
      <h1 class="text-6xl md:text-8xl font-bold tracking-tighter leading-none hero-title text-gray-900">
        Elevate Your<br/><span class="text-gray-400">Everyday.</span>
      </h1>
      <p class="text-lg text-gray-500 max-w-md font-body hero-desc mt-2">
        Discover a curated collection of premium essentials. Welcome back, <span class="font-bold text-gray-800"><%= user.fullname %></span>.
      </p>
      <div class="flex gap-4 mt-6 hero-btns">
        <a href="#featured-products" class="px-8 py-4 bg-gray-900 text-white rounded-full font-medium hover:bg-gray-800 hover:scale-105 transition-all duration-300 shadow-[0_8px_30px_rgb(0,0,0,0.12)]">
          Shop the Collection
        </a>
        <a href="#categories" class="px-8 py-4 bg-white text-gray-900 rounded-full font-medium hover:bg-gray-50 border border-gray-200 hover:border-gray-300 transition-all duration-300">
          Explore Categories
        </a>
      </div>
    </div>
  </section>

  <!-- CATEGORY PREVIEW -->
  <section id="categories" class="w-full py-24 px-8 md:px-20 bg-white section-fade">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">Shop by Category</h2>
        <p class="text-gray-500 font-body">Find exactly what you are looking for.</p>
      </div>
      <a href="#" class="hidden md:flex items-center gap-2 text-sm font-semibold text-gray-900 hover:text-gray-600 transition-colors group">
        View All <i class="ri-arrow-right-line group-hover:translate-x-1 transition-transform"></i>
      </a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Category Card 1 -->
      <a href="#" class="group relative h-96 rounded-3xl overflow-hidden bg-center bg-cover flex items-end p-8 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500" style="background-image: url('/images/apparel.png')">
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent z-10"></div>
        <div class="relative z-20 w-full flex justify-between items-center text-white">
          <h3 class="text-2xl font-bold">Apparel</h3>
          <div class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:translate-x-[-10px] transition-all duration-300"><i class="ri-arrow-right-up-line"></i></div>
        </div>
      </a>
      <!-- Category Card 2 -->
      <a href="#" class="group relative h-96 rounded-3xl overflow-hidden bg-center bg-cover flex items-end p-8 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500" style="background-image: url('/images/footwear.png')">
         <div class="absolute inset-0 bg-gradient-to-t from-gray-900/40 to-transparent z-10"></div>
        <div class="relative z-20 w-full flex justify-between items-center text-white">
          <h3 class="text-2xl font-bold">Footwear</h3>
          <div class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:translate-x-[-10px] transition-all duration-300"><i class="ri-arrow-right-up-line"></i></div>
        </div>
      </a>
      <!-- Category Card 3 -->
      <a href="#" class="group relative h-96 rounded-3xl overflow-hidden bg-center bg-cover flex items-end p-8 hover:shadow-2xl hover:-translate-y-2 transition-all duration-500" style="background-image: url('/images/accessories.png')">
         <div class="absolute inset-0 bg-gradient-to-t from-gray-900/40 to-transparent z-10"></div>
        <div class="relative z-20 w-full flex justify-between items-center text-white">
          <h3 class="text-2xl font-bold">Accessories</h3>
          <div class="w-10 h-10 rounded-full bg-white text-black flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:translate-x-[-10px] transition-all duration-300"><i class="ri-arrow-right-up-line"></i></div>
        </div>
      </a>
    </div>
  </section>

  <!-- FEATURED PRODUCTS -->
  <section id="featured-products" class="w-full py-24 px-8 md:px-20 bg-pastel-white section-fade">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-6">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">Featured Curations</h2>
        <p class="text-gray-500 font-body">Handpicked pieces for the modern aesthetic.</p>
      </div>
      
      <!-- Filters (Adapted from original layout) -->
      <div class="flex gap-4 items-center">
        <form action="/shop" class="flex items-center">
          <select name="sortby" onchange="this.form.submit()" class="bg-transparent border border-gray-200 rounded-full px-4 py-2 text-sm font-medium text-gray-700 outline-none focus:border-gray-900 transition-colors cursor-pointer appearance-none">
            <option value="popular">Sort: Popular</option>
            <option value="newest">Sort: Newest</option>
          </select>
        </form>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-8 gap-y-16">
      <% if (products.length > 0) { %>
        <% products.forEach(function(product) { %>
          <div class="group product-card flex flex-col cursor-pointer">
            <!-- Product Image Area -->
            <div class="relative w-full aspect-[4/5] rounded-2xl overflow-hidden mb-5 bg-[#<%= product.bgcolor %>] flex items-center justify-center px-6 transition-all duration-500 group-hover:shadow-[0_20px_40px_rgb(0,0,0,0.08)]">
              <% if (product.image) { %>
                <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>" class="w-full object-contain max-h-[80%] transition-transform duration-700 group-hover:scale-110 drop-shadow-xl" />
              <% } %>
              
              <!-- Quick Actions overlay on hover -->
              <div class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-6">
                <a href="/addtocart/<%= product._id %>" class="add-to-cart-btn translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 transition-all duration-300 delay-100 bg-white text-gray-900 font-semibold px-6 py-3 rounded-full shadow-lg hover:bg-gray-900 hover:text-white flex items-center gap-2 text-sm">
                  <i class="ri-shopping-cart-2-line"></i> Add to Cart
                </a>
              </div>
            </div>
            
            <!-- Product Info -->
            <div class="flex flex-col gap-1 px-1">
              <h3 class="text-lg font-bold text-gray-900 capitalize"><%= product.name %></h3>
              <div class="flex justify-between items-center mt-1">
                <p class="text-gray-500 font-medium tracking-wide">₹ <%= product.price %></p>
                <% if(product.discount > 0) { %>
                  <span class="text-xs font-bold text-red-500 bg-red-50 px-2 py-1 rounded-md">
                    -₹<%= product.discount %>
                  </span>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full py-20 text-center text-gray-400 text-lg">No products available at the moment.</div>
      <% } %>
    </div>
  </section>

  <!-- TESTIMONIALS (Static/Design display) -->
  <section class="w-full py-32 bg-gray-900 text-white section-fade overflow-hidden">
    <div class="max-w-4xl mx-auto text-center px-8 relative">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-12 opacity-10">
        <i class="ri-double-quotes-l text-9xl"></i>
      </div>
      <p class="text-2xl md:text-4xl font-medium leading-relaxed font-body mb-10 testimonial-text">
        "The minimal aesthetic completely elevated my daily life. Quality is unmatched and the purchasing experience was beautiful."
      </p>
      <div class="flex flex-col items-center">
        <div class="w-12 h-12 rounded-full bg-pastel-lavender mb-4 flex items-center justify-center text-purple-900 font-bold text-xl">
          E
        </div>
        <h4 class="font-bold tracking-widest uppercase text-sm text-gray-300">Elena Rostova</h4>
        <p class="text-xs text-gray-500 mt-1">Verified Buyer</p>
      </div>
    </div>
  </section>

</main>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    gsap.registerPlugin(ScrollTrigger);

    // Initial load animations
    const tl = gsap.timeline();
    tl.from(".hero-title", { y: +50, opacity: 0, duration: 1, ease: "power4.out", delay: 0.2 })
      .from(".hero-desc", { y: +20, opacity: 0, duration: 0.8, ease: "power3.out" }, "-=0.6")
      .from(".hero-pill", { scale: 0.8, opacity: 0, duration: 0.6, ease: "back.out(1.5)" }, "-=0.8")
      .from(".hero-btns > a", { y: +20, opacity: 0, duration: 0.6, stagger: 0.1, ease: "power3.out" }, "-=0.4");

    // Scroll Animations
    gsap.utils.toArray('.section-fade').forEach(section => {
      gsap.from(section, {
        scrollTrigger: {
          trigger: section,
          start: "top 80%",
          toggleActions: "play none none none"
        },
        y: 50,
        opacity: 0,
        duration: 1,
        ease: "power3.out"
      });
    });

    // Product cards stagger reveal
    gsap.from(".product-card", {
      scrollTrigger: {
        trigger: "#featured-products",
        start: "top 60%"
      },
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: "power2.out"
    });

    // Flash message dismissal
    const flash = document.querySelector('.flash-msg');
    if (flash) {
      setTimeout(() => {
        gsap.to(flash, { y: -20, opacity: 0, duration: 0.5, ease: "power2.in" });
      }, 4000);
    }

    const showCartMessage = (message, isError = false) => {
      let flashEl = document.querySelector(".flash-msg");

      if (!flashEl) {
        flashEl = document.createElement("div");
        flashEl.className = "fixed top-24 left-1/2 transform -translate-x-1/2 z-[1001] px-6 py-3 rounded-full shadow-lg flex items-center gap-3 font-medium text-sm flash-msg";
        document.body.appendChild(flashEl);
      }

      flashEl.className = `fixed top-24 left-1/2 transform -translate-x-1/2 z-[1001] px-6 py-3 rounded-full shadow-lg flex items-center gap-3 font-medium text-sm flash-msg ${
        isError
          ? "bg-red-50 border border-red-100 text-red-600"
          : "bg-emerald-50 border border-emerald-100 text-emerald-600"
      }`;
      flashEl.innerHTML = `
        <i class="${isError ? "ri-error-warning-fill" : "ri-checkbox-circle-fill"} text-lg"></i>
        <span>${message}</span>
      `;

      gsap.killTweensOf(flashEl);
      gsap.set(flashEl, { y: 0, opacity: 1 });
      setTimeout(() => {
        gsap.to(flashEl, { y: -20, opacity: 0, duration: 0.5, ease: "power2.in" });
      }, 4000);
    };

    document.querySelectorAll(".add-to-cart-btn").forEach((button) => {
      button.addEventListener("click", async (event) => {
        event.preventDefault();

        const url = button.getAttribute("href");
        if (!url) return;

        try {
          const response = await fetch(url, {
            method: "GET",
            headers: {
              Accept: "application/json",
              "X-Requested-With": "XMLHttpRequest",
            },
          });

          const data = await response.json();

          if (!response.ok || !data.success) {
            showCartMessage(data.message || "Unable to add product to cart", true);
            return;
          }

          showCartMessage(data.message || "Product added to cart successfully!");
        } catch (error) {
          showCartMessage("Unable to add product to cart", true);
        }
      });
    });
  });

  // --- THREE.JS LIGHTWEIGHT 3D EFFECT ---
  const initThreeJS = () => {
    const container = document.getElementById('three-canvas');
    if (!container) return;

    const scene = new THREE.Scene();
    
    // Setup camera
    const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.z = 5;

    // Setup renderer
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Create a smooth abstract object (TorusKnot acts as a premium glass/pastel sculpture)
    const geometry = new THREE.TorusKnotGeometry(1.2, 0.4, 200, 32);
    
    // MeshPhongMaterial for a soft, plastic-y pastel look
    const material = new THREE.MeshPhongMaterial({ 
      color: 0xE3EDF7, // Pastel Blue matching Tailwind config
      emissive: 0x111111,
      specular: 0xffffff,
      shininess: 90,
      flatShading: false
    });
    
    const torusKnot = new THREE.Mesh(geometry, material);
    scene.add(torusKnot);

    // Lights
    const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
    scene.add(ambientLight);

    const dirLight1 = new THREE.DirectionalLight(0xffffff, 0.8);
    dirLight1.position.set(1, 1, 1);
    scene.add(dirLight1);

    const dirLight2 = new THREE.DirectionalLight(0xF1E9FE, 0.8); // Muted lavender light
    dirLight2.position.set(-1, -1, 1);
    scene.add(dirLight2);

    // Mouse Interaction
    let mouseX = 0;
    let mouseY = 0;
    let targetX = 0;
    let targetY = 0;

    const windowHalfX = window.innerWidth / 2;
    const windowHalfY = window.innerHeight / 2;

    document.addEventListener('mousemove', (event) => {
      mouseX = (event.clientX - windowHalfX) * 0.001;
      mouseY = (event.clientY - windowHalfY) * 0.001;
    });

    // Animation Loop
    const clock = new THREE.Clock();

    const animate = () => {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      // Smooth rotation
      torusKnot.rotation.y = elapsedTime * 0.2;
      torusKnot.rotation.x = elapsedTime * 0.1;

      // Mouse parallax
      targetX = mouseX * 0.5;
      targetY = mouseY * 0.5;

      torusKnot.rotation.y += 0.05 * (targetX - torusKnot.rotation.y);
      torusKnot.rotation.x += 0.05 * (targetY - torusKnot.rotation.x);
      
      // Floating effect
      torusKnot.position.y = Math.sin(elapsedTime) * 0.2;

      renderer.render(scene, camera);
    };
    
    animate();

    // Handle Resize
    window.addEventListener('resize', () => {
      if(container) {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
      }
    });
  };

  initThreeJS();
</script>

<%- include('./partials/footer') %>
