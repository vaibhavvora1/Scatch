
  

<%- include('./partials/header') %>
<!-- Flash Messages Container -->
<div id="flash-container" class="fixed top-24 left-1/2 -translate-x-1/2 z-[1100] flex flex-col gap-3 w-full max-w-sm px-4 pointer-events-none">
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="flash-message bg-red-50 text-red-600 border border-red-100 px-5 py-3.5 rounded-2xl shadow-sm flex items-center text-sm font-medium opacity-0">
      <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <%= error %>
    </div>
  <% } %>
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="flash-message bg-emerald-50 text-emerald-600 border border-emerald-100 px-5 py-3.5 rounded-2xl shadow-sm flex items-center text-sm font-medium opacity-0">
      <svg class="w-5 h-5 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <%= success %>
    </div>
  <% } %>
</div>
<!-- Main UI full height background -->
<div class="w-full min-h-screen flex items-center justify-center bg-[#fcfcfc] font-sans p-4">
  
  <!-- Central Auth Card -->
  <div id="auth-container" class="relative w-full max-w-[400px] bg-white rounded-[2rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100/60 overflow-hidden opacity-0 translate-y-8 min-h-[500px]">
    
    <!-- Login Section -->
    <div id="login-section" class="absolute inset-0 p-8 sm:p-10 flex flex-col justify-between z-10 bg-white">
      <div>
        <div class="mb-10">
          <h3 class="text-3xl font-semibold text-zinc-800 tracking-tight">Welcome</h3>
          <p class="text-zinc-500 text-sm mt-2">Log in to your account</p>
        </div>
        <form autocomplete="off" action="/users/login" method="post" class="space-y-4">
          <div class="form-element relative">
            <input class="w-full px-5 py-4 rounded-2xl bg-zinc-50 border-[1.5px] border-transparent focus:bg-white focus:border-zinc-200 focus:ring-4 focus:ring-zinc-100/50 transition-all outline-none text-zinc-800 placeholder:text-zinc-400 text-sm font-medium" type="email" placeholder="Email" name="email" required />
          </div>
          <div class="form-element relative">
            <input class="w-full px-5 py-4 rounded-2xl bg-zinc-50 border-[1.5px] border-transparent focus:bg-white focus:border-zinc-200 focus:ring-4 focus:ring-zinc-100/50 transition-all outline-none text-zinc-800 placeholder:text-zinc-400 text-sm font-medium" type="password" placeholder="Password" name="password" required />
          </div>
          <div class="form-element pt-2">
            <input class="w-full py-4 rounded-2xl bg-zinc-900 hover:bg-zinc-800 text-white font-medium transition-all cursor-pointer active:scale-[0.98] text-sm shadow-md shadow-zinc-200" type="submit" value="Sign In" />
          </div>
        </form>
      </div>
      <div class="text-center mt-6 form-element pb-2 mt-auto">
        <p class="text-sm text-zinc-500">
          Don't have an account? 
          <button type="button" onclick="switchToRegister()" class="font-semibold text-zinc-900 hover:text-zinc-600 transition-colors">Create one</button>
        </p>
      </div>
    </div>
    <!-- Register Section (Hidden by default) -->
    <div id="register-section" class="absolute inset-0 p-8 sm:p-10 flex flex-col justify-between z-20 bg-white hidden">
       <div>
        <div class="mb-8">
          <h3 class="text-3xl font-semibold text-zinc-800 tracking-tight">Join <span class="text-black">Scatch</span></h3>
          <p class="text-zinc-500 text-sm mt-1">Create an account to continue</p>
        </div>
        <form autocomplete="off" action="/users/register" method="post" class="space-y-4">
          <div class="form-element relative">
            <input class="w-full px-5 py-4 rounded-2xl bg-zinc-50 border-[1.5px] border-transparent focus:bg-white focus:border-zinc-200 focus:ring-4 focus:ring-zinc-100/50 transition-all outline-none text-zinc-800 placeholder:text-zinc-400 text-sm font-medium" type="text" placeholder="Full Name" name="fullname" required />
          </div>
          <div class="form-element relative">
            <input class="w-full px-5 py-4 rounded-2xl bg-zinc-50 border-[1.5px] border-transparent focus:bg-white focus:border-zinc-200 focus:ring-4 focus:ring-zinc-100/50 transition-all outline-none text-zinc-800 placeholder:text-zinc-400 text-sm font-medium" type="email" placeholder="Email" name="email" required />
          </div>
          <div class="form-element relative">
            <input class="w-full px-5 py-4 rounded-2xl bg-zinc-50 border-[1.5px] border-transparent focus:bg-white focus:border-zinc-200 focus:ring-4 focus:ring-zinc-100/50 transition-all outline-none text-zinc-800 placeholder:text-zinc-400 text-sm font-medium" type="password" placeholder="Password" name="password" required />
          </div>
          <div class="form-element pt-2">
            <input class="w-full py-4 rounded-2xl bg-zinc-900 hover:bg-zinc-800 text-white font-medium transition-all cursor-pointer active:scale-[0.98] text-sm shadow-md shadow-zinc-200" type="submit" value="Sign Up" />
          </div>
        </form>
       </div>
       <div class="text-center mt-6 form-element hidden-form-element mt-auto">
        <p class="text-sm text-zinc-500">
          Already have an account? 
          <button type="button" onclick="switchToLogin()" class="font-semibold text-zinc-900 hover:text-zinc-600 transition-colors">Sign In</button>
        </p>
      </div>
    </div>
  </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", () => {
  // Initial setup hidden states for animation
  gsap.set("#register-section", { display: "none", opacity: 0, x: 30 });

  const tl = gsap.timeline();

  // Animate the main card container in
  tl.to("#auth-container", {
    opacity: 1,
    y: 0,
    duration: 1,
    ease: "power4.out",
  });
  // Stagger all login elements slightly from the bottom
  tl.fromTo(
    "#login-section > div:first-child",
    { opacity: 0, y: 15 },
    { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" },
    "-=0.6",
  );

  tl.fromTo(
    "#login-section .form-element",
    { opacity: 0, y: 10 },
    { opacity: 1, y: 0, duration: 0.5, stagger: 0.08, ease: "power2.out" },
    "-=0.4",
  );
  // Animate flash messages if they are present
  if (document.querySelectorAll(".flash-message").length > 0) {
    gsap.fromTo(
      ".flash-message",
      { opacity: 0, y: -20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.1,
        ease: "back.out(1.5)",
        delay: 0.2,
      },
    );

    // Auto-hide the flash message after a few seconds
    setTimeout(() => {
      gsap.to(".flash-message", {
        opacity: 0,
        y: -10,
        duration: 0.4,
        stagger: 0.1,
        ease: "power2.in",
      });
    }, 3000);
  }
});
const loginSection = document.getElementById("login-section");
const registerSection = document.getElementById("register-section");
let isAnimating = false;
function switchToRegister() {
  if (isAnimating) return;
  isAnimating = true;
  const tl = gsap.timeline({ onComplete: () => (isAnimating = false) });

  // Slide login out to the left
  tl.to(loginSection, {
    opacity: 0,
    x: -30,
    duration: 0.4,
    ease: "power3.inOut",
    onComplete: () => {
      gsap.set(loginSection, { display: "none" });
      gsap.set(registerSection, { display: "flex", x: 30 });
    },
  });
  // Slide register in from the right
  tl.to(registerSection, {
    opacity: 1,
    x: 0,
    duration: 0.5,
    ease: "power3.out",
  });
}
function switchToLogin() {
  if (isAnimating) return;
  isAnimating = true;
  const tl = gsap.timeline({ onComplete: () => (isAnimating = false) });

  // Slide register out to the right
  tl.to(registerSection, {
    opacity: 0,
    x: 30,
    duration: 0.4,
    ease: "power3.inOut",
    onComplete: () => {
      gsap.set(registerSection, { display: "none" });
      gsap.set(loginSection, { display: "flex", x: -30 });
    },
  });
  // Slide login in from the left
  tl.to(loginSection, { opacity: 1, x: 0, duration: 0.5, ease: "power3.out" });
}

</script>

<%- include('./partials/footer') %>
