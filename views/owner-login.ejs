<%- include('./partials/header') %>
<div class="w-full h-screen flex px-20">
  <div class="w-1/2 flex items-center justify-center h-screen">
    <div class="w-full px-32">
      <h4 class="text-2xl capitalize mb-5">Admin Access</h4>
      <% if (error && error.length > 0) { %>
        <div class="mb-4 rounded-md border border-red-200 bg-red-50 px-4 py-3 text-red-600">
          <%= error[0] %>
        </div>
      <% } %>
      <% if (success && success.length > 0) { %>
        <div class="mb-4 rounded-md border border-green-200 bg-green-50 px-4 py-3 text-green-600">
          <%= success[0] %>
        </div>
      <% } %>
      <form action="/owners/login" method="post">
        <input
          class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="email"
          placeholder="Email"
          name="email"
        />
        <input
          class="block bg-zinc-100 w-full px-3 py-2 border-[1px] rounded-md mb-3 border-zinc-200"
          type="password"
          placeholder="Password"
          name="password"
        />
        <input
          class="px-5 rounded-full py-3 mt-2 bg-blue-500 text-white"
          type="submit"
          value="Login"
        />
      </form>
      <p class="mt-5 text-sm text-zinc-500">
        Need to create owner account?
        <a href="/ownerregister" class="font-semibold text-zinc-900">Register owner</a>
      </p>
    </div>
  </div>
</div>
<%- include('./partials/footer') %>
