<%- include('./partials/header') %>

<div class="min-h-screen bg-zinc-50 px-4 py-10">
  <div class="mx-auto max-w-md rounded-3xl border border-zinc-200 bg-white p-8 shadow-sm">
    <div class="mb-8">
      <h1 class="text-3xl font-semibold text-zinc-900">Owner Register</h1>
      <p class="mt-2 text-sm text-zinc-500">Create the owner account and continue to login.</p>
    </div>

    <% if (error && error.length > 0) { %>
      <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">
        <%= error[0] %>
      </div>
    <% } %>

    <% if (success && success.length > 0) { %>
      <div class="mb-4 rounded-2xl border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-600">
        <%= success[0] %>
      </div>
    <% } %>

    <form action="/owners/ownerregister" method="post" class="space-y-4">
      <input
        class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 outline-none transition focus:border-zinc-400 focus:bg-white"
        type="text"
        name="fullname"
        placeholder="Full Name"
        required
      />
      <input
        class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 outline-none transition focus:border-zinc-400 focus:bg-white"
        type="email"
        name="email"
        placeholder="Email"
        required
      />
      <input
        class="w-full rounded-2xl border border-zinc-200 bg-zinc-50 px-4 py-3 outline-none transition focus:border-zinc-400 focus:bg-white"
        type="password"
        name="password"
        placeholder="Password"
        required
      />
      <input
        class="w-full cursor-pointer rounded-2xl bg-zinc-900 py-3 font-medium text-white transition hover:bg-zinc-800"
        type="submit"
        value="Register Owner"
      />
    </form>

    <p class="mt-6 text-center text-sm text-zinc-500">
      Already registered?
      <a href="/ownerlogin" class="font-semibold text-zinc-900">Go to owner login</a>
    </p>
  </div>
</div>

<%- include('./partials/footer') %>
